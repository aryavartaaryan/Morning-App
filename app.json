{
  "expo": {
    "name": "Svara",
    "slug": "nada-arise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "solrize",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#04030F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.solrize",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "processing",
          "location"
        ],
        "NSUserNotificationsUsageDescription": "Svara uses notifications to ring your wake alarm.",
        "NSLocationWhenInUseUsageDescription": "Svara tracks your walk distance during your sessions.",
        "NSMotionUsageDescription": "Svara uses motion sensors to accurately count your walking steps.",
        "NSHealthShareUsageDescription": "Svara tracks your steps and activity for walk sessions.",
        "NSHealthUpdateUsageDescription": "Svara logs your walking activity and steps.",
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.solrize.alarm-reschedule"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "translucent": true,
      "barStyle": "light-content"
    },
    "android": {
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#04030F",
        "dark": {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#04030F"
        }
      },
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.solrize",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.475392538883-6ja9mvphv6lhgpk7f4cdebrbar1ru601"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.TURN_SCREEN_ON",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.BODY_SENSORS",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/mantra_alarm.m4a"
          ],
          "androidMode": "default",
          "androidCollapsedTitle": "Svara",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Svara to access your camera for mission completion."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Svara to access your photos for mission completion."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Svara to show local weather and track your walk."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class app.notifee.** { *; }\n-keep class com.solrize.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.google.firebase.** { *; }\n-keep class com.google.android.gms.** { *; }\n-dontwarn com.google.firebase.**\n-dontwarn javax.annotation.**",
            "enableMinifyInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf7a49b3-2dba-415a-a28a-74ac9e62a452"
      }
    },
    "owner": "aryasona"
  }
}
