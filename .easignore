# Backup and temp files
*.bak
*.NEW

# Local Expo export output — not needed for EAS remote build
dist/

# Backend (not needed for mobile build)
backend/

# iOS native project & Swift source — not needed for Android build
ios/
ios_src/

# Git
.git/

# Node modules — EAS runs npm install on its own Linux servers.
# If node_modules is included, EAS skips npm install and uses
# the uploaded macOS-compiled binaries → build fails on Linux.
node_modules/

# Android native project — EAS Build uses this folder directly (non-CNG mode).
# Adding /android here would strip native code; we KEEP it so EAS uses our
# committed native project. Build cache folders are excluded individually below.
android/app/build/
android/build/
android/.gradle/
android/.kotlin/
android/.cxx/

# Expo local cache
.expo/

# Misc
.DS_Store
*.tsbuildinfo
npm-debug.*
yarn-debug.*
yarn-error.*

# Docs and scripts not needed for build
*.md
*.sh
*.bak
*.NEW

